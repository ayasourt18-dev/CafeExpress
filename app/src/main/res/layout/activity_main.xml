<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F1">

    <TextView
        android:id="@+id/txtTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Café Express"
        android:textColor="#4E342E"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtSousTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Prise de commande"
        android:textColor="#795548"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtSousTitre"
        app:layout_constraintBottom_toTopOf="@id/btnVider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#F5E6Da"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Café"
                    android:textColor="#3E2723"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="10 DH"
                    android:textColor="#5D4037"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnMoinsCafe"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#A1887F"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:textAllCaps="false"/>

                <TextView
                    android:id="@+id/txtQteCafe"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlusCafe"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:textAllCaps="false"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#F5E6DA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Thé"
                    android:textColor="#3E2723"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8 DH"
                    android:textColor="#5D4037"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnMoinsThe"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#A1887F"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:textAllCaps="false"/>

                <TextView
                    android:id="@+id/txtQteThe"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlusThe"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:textAllCaps="false"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="#F5E6DA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Croissant"
                    android:textColor="#3E2723"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="6 DH"
                    android:textColor="#5D4037"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnMoinsCroissant"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#A1887F"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:textAllCaps="false"
                    />

                <TextView
                    android:id="@+id/txtQteCroissant"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlusCroissant"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#6D4C41"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:textAllCaps="false"/>

            </LinearLayout>
            <TextView
                android:id="@+id/lblClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Nom du client"
                android:textColor="#4E342E"
                android:textSize="18sp"
                android:textStyle="bold"
                />

            <EditText
                android:id="@+id/edtClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#8D6E63"
                android:hint="Ex : Sara"
                android:inputType="textPersonName"
                android:padding="10dp"
                android:textSize="18sp"
                android:textColor="#6B0B0B"/>
            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Total : 0 DH"
                android:textColor="#3E2723"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
    <Button
        android:id="@+id/btnVider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#8D6E63"
        android:text="Vider"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCommander"
        app:layout_constraintBottom_toBottomOf="parent" />
    <Button
        android:id="@+id/btnCommander"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#5D4037"
        android:text="Commander"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@id/btnVider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>